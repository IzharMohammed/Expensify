DATABASE_URL=postgres://postgres:postgres@localhost:5432/expensify
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-second-long-random-string
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
GROQ_API_KEY=your-groq-api-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=expensify-receipts
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
REDIS_URL=redis://localhost:6379
APP_TIMEZONE=Asia/Kolkata
GAMIFICATION_CRON=15 0 * * *
INSIGHTS_CRON=0 23 * * *
RECURRING_SCAN_CRON=0 2 * * 1
RECURRING_REMINDER_CRON=0 9 * * *
NO_SPEND_NUDGE_CRON=0 20 * * *
WEEKEND_ANOMALY_CRON=0 8 * * 1
BULL_BOARD_ROUTE=/admin/queues
